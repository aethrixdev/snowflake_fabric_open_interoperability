# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already excluded in .gitignore.

# ---------- Azure / ADLS Gen2 ----------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_STORAGE_ACCOUNT=mystorageaccount
AZURE_STORAGE_CONTAINER=lakehouse
AZURE_SP_NAME=sp-snowflake-fabric-interop
AZURE_SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_SP_CLIENT_SECRET=changeme
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-lakehouse-demo
AZURE_LOCATION=eastus2

# ---------- Snowflake ----------
SNOWFLAKE_ACCOUNT=xy12345.eastus2.azure
SNOWFLAKE_USER=svc_lakehouse
SNOWFLAKE_PASSWORD=changeme
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=LAKEHOUSE_WH
SNOWFLAKE_DATABASE=ecommerce_demo
SNOWFLAKE_EXTERNAL_VOLUME=iceberg_ext_vol
SNOWFLAKE_STORAGE_INTEGRATION=azure_lakehouse_int

# ---------- Microsoft Fabric ----------
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_LAKEHOUSE_NAME=interop_lakehouse
FABRIC_SQL_ENDPOINT=xxxxxxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=interop_lakehouse
FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_SECRET=changeme

# ---------- Project paths (relative to ADLS container root) ----------
ICEBERG_GOLD_BASE_LOCATION=gold/revenue_by_country_iceberg/
DELTA_GOLD_BASE_LOCATION=gold/revenue_by_country_delta/
